{
  "name": "better-repos",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "prepare:env": "node scripts/ci/prepare.mjs --write",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:coverage": "node --import=tsx --test --experimental-test-coverage \"src/**/*.test.ts\"",
    "test:coverage:check": "node scripts/ci/check-coverage.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "wrangler": "^4.130.0"
  },
  "engines": {
    "node": ">=22"
  }
}
